pragma solidity ^0.8.25;

import {SHA512} from "../src/SHA512.sol";

/// Vectors are FIPS 180-4's own three, the block-boundary cases at 111 to 129 bytes where the
/// padding rule decides whether a second block is appended, and ten random messages. Every
/// expected digest was produced by Python's `hashlib.sha512`, which is OpenSSL, so this is a
/// differential test against a reference implementation and not a transcription of a table.
contract SHA512Test {
    uint256 internal fails;

    function _check(bytes memory msg_, bytes memory want, uint256 i) internal {
        bytes memory got = SHA512.hash(msg_);
        if (keccak256(got) != keccak256(want)) {
            fails++;
            revert(string.concat("SHA-512 mismatch at vector ", _u(i)));
        }
    }

    function _u(uint256 v) internal pure returns (string memory) {
        if (v == 0) return "0";
        uint256 n = v;
        uint256 d;
        while (n != 0) { d++; n /= 10; }
        bytes memory b = new bytes(d);
        while (v != 0) { b[--d] = bytes1(uint8(48 + (v % 10))); v /= 10; }
        return string(b);
    }

    function test_vectors() public {
        _check(hex"", hex"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", 0);
        _check(hex"616263", hex"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", 1);
