    /// The empty message is the case a padding bug is most likely to pass by accident, so it is
    /// asserted on its own as well.
    function test_emptyMessage() public {
        bytes memory got = SHA512.hash("");
        require(
            keccak256(got) ==
                keccak256(
                    hex"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
                ),
            "empty message digest wrong"
        );
    }
